# Copy to .env and fill in. NEVER commit .env.

# Web UI
PORT=3000
SITE_TITLE=News Terminal
APP_PASSWORD=choose_a_strong_password_at_least_8_chars
SESSION_SECRET=replace_with_a_random_32_character_or_longer_string
DB_PATH=./data.db

# LLM: "gemini" or "openai"
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL_ID=
OPENAI_BASE_URL=

# Twitter/X cookies (only needed if you enable a twitter_list source)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Optional — HuggingNews media_list source
HUGGINGNEWS_API_KEY=
