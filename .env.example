# Example env for local-run.mjs. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored; this template is safe to commit. Never put real
# secrets (cookies, API keys) in this file.

# ── App ─────────────────────────────────────────────────────────────
PORT=3999
APP_PASSWORD=changeme
# Any long random string. Generate one: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me
# Optional — where the SQLite store lives (defaults to ./pulse.local.db)
# DB_PATH=./pulse.local.db

# ── LLM (tweet summaries + the TL;DR digest) ────────────────────────
# provider: "gemini" (default) or "openai" (also any OpenAI-compatible gateway)
LLM_PROVIDER=openai
LLM_API_KEY=
# OpenAI-compatible gateways only. May be a bare base (…/v1) or include the
# full …/v1/chat/completions path. Leave blank for api.openai.com.
OPENAI_BASE_URL=https://api.nexos.ai/v1/chat/completions
# Model id. Defaults: gemini-3.1-pro-preview (gemini) / gpt-4o (openai).
# Gateways like nexos.ai identify the model by a UUID — set it here.
OPENAI_MODEL_ID=
# LLM_MODEL_ID=            # alternative name; takes precedence if both set

# ── Twitter/X (for the twitter_list sources) ────────────────────────
# Cookie VALUES from a logged-in x.com session:
#   DevTools > Application > Cookies > https://x.com > copy auth_token and ct0
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# Numeric list id from the URL: x.com/i/lists/<THIS_NUMBER>. A list source
# only activates when its *_ID is set AND both cookies above are present.
TWITTER_LIST_ID=
TWITTER_LIST_NAME=AI Products - Workspace
# Second list (optional) — add more pairs in local-run.mjs's twitterLists[].
TWITTER_LIST_ID_2=
TWITTER_LIST_NAME_2=AI Products - Gateway

# ── HuggingNews (media_list source) ─────────────────────────────────
# Optional — the source works anonymously without a key.
# HUGGINGNEWS_API_KEY=
